# 复制为 .env 后在本机填写；不提交真实令牌。
MODEL_API_URL=https://chat.ecnu.edu.cn/open/api/v1
MODEL_NAME=ecnu-plus
MODEL_VIDEO_NAME=ecnu-max
MODEL_API_KEY=
ASR_BACKEND=local
# 可选调度参数。实际额度以服务控制台/官方文档为准。
MAX_PARALLEL=4
MODEL_MAX_CONCURRENCY=2
MODEL_RPM=0
# legacy 保留原参考请求；ecnu 发送官方 thinking.disabled；none 不加厂商扩展字段。
MODEL_THINKING_FORMAT=ecnu
MODEL_API_PROFILE=openai
MODEL_SOLVER_THINKING=disabled
# off 保留每次重新预处理；readwrite 可复用同输入、模型及处理代码的完整成功文档。
KDD_DOC_CACHE_MODE=readwrite
