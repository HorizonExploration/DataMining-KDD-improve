# 官方 API 的候选配置；未联调，不包含令牌。复制为 .env.deepseek 后本机填写。
MODEL_API_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_VERSION_LABEL=DeepSeek-V4.1-Flash-1017
MODEL_API_KEY=
MODEL_API_PROFILE=deepseek
MODEL_THINKING_FORMAT=deepseek
# 先以非思考求解验证速度；质量对照另存配置改为 enabled。
MODEL_SOLVER_THINKING=disabled
ASR_BACKEND=local
MAX_PARALLEL=1
MODEL_MAX_CONCURRENCY=3
MODEL_RPM=0
KDD_DOC_CACHE_MODE=off
